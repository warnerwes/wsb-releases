  },
  "build_commands": [
    "tar -xf libde265-1.1.0.tar.gz --strip-components 1 && mkdir build && cd build",
    "cmake -DCMAKE_INSTALL_PREFIX=/usr/local -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_NAME_DIR=/usr/local/lib -DCMAKE_PREFIX_PATH=/usr/local -DCMAKE_LIBRARY_PATH=/usr/local/lib -DCMAKE_INCLUDE_PATH=/usr/local/include",
    "make -j4",
    "make install",
    "delocate (cibuildwheel) copies the dylib into pi_heif/.dylibs/"
