{
  "toolchain": "GitHub Actions macos-14 (arm64), Apple clang (SDK 14.5 per LC_BUILD_VERSION), CMake >= 3.16.3, MACOSX_DEPLOYMENT_TARGET=11.0; then cibuildwheel 3.2.1 + delocate (.dylibs)",
  "configuration": {
    "cmake_args": [
      "-DCMAKE_INSTALL_PREFIX=/usr/local",
      "-DCMAKE_BUILD_TYPE=Release",
      "-DCMAKE_INSTALL_NAME_DIR=/usr/local/lib",
      "-DCMAKE_PREFIX_PATH=/usr/local",
      "-DCMAKE_LIBRARY_PATH=/usr/local/lib",
      "-DCMAKE_INCLUDE_PATH=/usr/local/include"
    ],
    "env": {
      "PH_LIGHT_ACTION": "1",
      "MACOSX_DEPLOYMENT_TARGET": "11.0",
      "INSTALL_DIR_LIBS": "/usr/local (default on Darwin)"
    },
